@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Confirmação de alteração de senha";
}
<style>
    .mb-3 {
        margin-bottom: 0 !important;
    }
    .pb-3 {
        padding-bottom: 0 !important;
    }
    .container {
        margin: 0 !important;
        padding: 0 !important;
    }
    .container-formulario {
        display: flex;
        height: 85vh;
        border-radius: 10px;
        justify-content: space-between;
        width: 100vw;
        flex-direction: row-reverse;
    }
    .form-image {
        display: flex;
        justify-content: space-around;
        align-items: center;
        background-color: #6FC6FF;
        border-radius: 5px;
        width: 40%;
    }
    .form-image img {
        width: 350px;
        height: 322px;
    }
    .form {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        display: flex;
        width: 50%;
        padding: 3rem;
    }
    .form-header {
        text-align: center;
        margin-bottom: 20px;
    }
    .form-header h3 {
        text-align: center;
        margin-bottom: 20px;
        font-size: 16px;
    }
    .form-header2 {
        text-align: center;
        margin-bottom: 20px;
        width: 100%;
    }
    .form-header2 h2 {
        font-size: 24px;
        margin-left: 10px;
    }
    .enter-buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 20px;
    }
    .btn-primary {
        background-color: #007bff;
        border: none;
        padding: 0.75rem;
        font-size: 1rem;
        font-weight: 600;
    }
    .btn-primary:hover {
        background-color: #0056b3;
    }
    .text-center {
        text-align: center;
        margin: 5px 0;
    }
</style>



<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/teladelogin.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    <div class="container-formulario">
        <div class="form-image">
            <img src="/src/logo.png" alt="Logo">
        </div>
        <div class="form">
            <div class="form-header">
                <h1>Você redefiniu sua senha com sucesso.</h1>
            </div>
            <p>
                Sua senha foi redefinida. Por favor, <a asp-page="./Login">clique aqui para fazer login</a>.
            </p>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>