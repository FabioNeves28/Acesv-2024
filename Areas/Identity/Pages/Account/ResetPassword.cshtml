@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        .mb-3 {
            margin-bottom: 0 !important;
        }

        .pb-3 {
            padding-bottom: 0 !important;
        }

        .container {
            margin: 0 !important;
            padding: 0 !important;
        }

        .container-formulario {
            display: flex;
            height: 85vh;
            border-radius: 10px;
            justify-content: space-between;
            width: 100vw;
            flex-direction: row-reverse;
        }

        .form-image {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background-color: #6FC6FF;
            border-radius: 5px;
            width: 40%;
        }

            .form-image img {
                width: 350px;
                height: 322px;
            }

        .form {
            flex-direction: column;
            justify-content: center;
            align-items: center;
            display: flex;
            width: 50%;
            padding: 3rem;
        }

        .form-header2 {
            text-align: center;
            margin-bottom: 20px;
            width: 100%;
        }

            .form-header2 h2 {
                font-size: 28px;
                margin-left: 10px;
            }

        .input-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 90px;
        }

        .input-box {
            position: relative;
            margin-bottom: 20px;
            margin-top: 0;
            width: 100%;
        }

            .input-box input {
                width: 100%;
                padding: 8px;
                font-size: 16px;
                border: 1px solid #ccc;
                border-radius: 10px;
                outline: none;
                height: 40px;
                box-sizing: border-box;
            }

                .input-box input:focus {
                    border-color: #6FC6FF;
                    box-shadow: none;
                }

        .text-danger {
            font-size: 0.9rem;
            height: 1.2rem; 
            color: red;
            margin: 0; 
        }

        .error-container {
            height: 24px;
        }

        .enter-buttons {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-top: 20px;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>
    <div class="container-formulario">
        <div class="form-image">
            <img src="/src/logo.png" alt="Logo">
        </div>
        <div class="form">
            <div class="form-header2">
                <h2>REDEFINIR SENHA</h2>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Input.Code" type="hidden" />

                <div class="input-group">
                    <div class="input-box">
                        <input asp-for="Input.Email" placeholder="E-mail" type="email" autocomplete="username" aria-required="true" required />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="input-box">
                        <input asp-for="Input.Password" placeholder="Nova senha" type="password" autocomplete="new-password" aria-required="true" required />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="input-box">
                        <input asp-for="Input.ConfirmPassword" placeholder="Confirme a senha" type="password" autocomplete="new-password" aria-required="true" required />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="error-container">
                        <span asp-validation-summary="All" class="text-danger"></span>
                    </div>

                    <div class="enter-buttons">
                        <button type="submit" class="btn btn-lg btn-primary">Redefinir</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
