@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<h1>@ViewData["Title"]</h1>
<!-- Adicione isso no cabeçalho (head) da sua página -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.6/jquery.inputmask.min.js"></script>
<!-- Adicione isso antes do fechamento da tag </body> -->
<!-- Seu código HTML existente -->
<!-- Script para aplicar a máscara -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro ACESV</title>
    <!-- Link para Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/registro.css">
    <script defer src="~/js/registro.js"></script>
</head>

<script>
    function mascara(i, t) {

        var v = i.value;

        if (isNaN(v[v.length - 1])) {
            i.value = v.substring(0, v.length - 1);
            return;
        }

        if (t == "cpf") {
            i.setAttribute("maxlength", "14");
            if (v.length == 3 || v.length == 7) i.value += ".";
            if (v.length == 11) i.value += "-";
        }
    }
</script>


<div class="row">
    <body>
        <style>
            .navbar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                z-index: 1000 !important;
            }
        </style>
        <script>
            function mascara(i, t) {

                var v = i.value;

                if (isNaN(v[v.length - 1])) {
                    i.value = v.substring(0, v.length - 1);
                    return;
                }

                if (t == "cpf") {
                    i.setAttribute("maxlength", "14");
                    if (v.length == 3 || v.length == 7) i.value += ".";
                    if (v.length == 11) i.value += "-";
                }
            }
            document.getElementById("registerForm").addEventListener("submit", function (event) {
                const password = document.getElementById("senha").value;
                const confirmPassword = document.getElementById("confirmar-senha").value;
                let errorMessage = "";

                if (password.length < 6) {
                    errorMessage += "A senha deve ter no mínimo 6 caracteres.\n";
                }

                if (!/[!#$%^&*()]/.test(password)) {
                    errorMessage += "A senha deve conter pelo menos um caractere especial como !, #.\n";
                }

                if (password !== confirmPassword) {
                    errorMessage += "A senha e a confirmação da senha não são iguais.\n";
                }

                if (errorMessage) {
                    event.preventDefault();  // Impede o envio do formulário
                    alert(errorMessage);  // Exibe a mensagem de erro
                }
            });
        </script>
        <div class="wrapper">
            <div class="form-wrapper">
                <h2>CADASTRE-SE</h2>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="display:flex; justify-content:center"></div><br />
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                    <div class="field-group">
                        <label for="email">
                            <img src="https://img.icons8.com/material-outlined/24/000000/new-post.png" alt="E-mail Icon" />
                        </label>
                        <input asp-for="Input.Cpf" oninput="mascara(this, 'cpf')" id="cpfInput" class="form-control" autocomplete="new-password" aria-required="true" maxlength="11" placeholder="CPF" />
                    </div>
                    <div class="field-group">
                        <label for="email">
                            <img src="https://img.icons8.com/material-outlined/24/000000/new-post.png" alt="E-mail Icon" />
                        </label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="Email" />
                    </div>
                    <div class="field-group">
                        <label for="senha">
                            <img src="https://img.icons8.com/?size=24&id=82747&format=png&color=000000" alt="password Icon" />
                        </label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" id="senha" placeholder="Senha" />
                        <span class="show-password" onclick="togglePassword('senha')">
                            <i class="far fa-eye" id="eye-senha"></i>
                        </span>
                    </div>
                    <div class="field-group">
                        <label for="confirmar-senha">
                            <img src="https://img.icons8.com/?size=24&id=82747&format=png&color=000000" alt="Password Icon" />
                        </label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmar-senha" placeholder="Confirme sua Senha" />
                        <span class="show-password" onclick="togglePassword('confirmar-senha')">
                            <i class="far fa-eye" id="eye-confirmar-senha"></i>
                        </span>
                    </div>
                    <br />
                    <center>
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Cadastrar</button>
                    </center>
                </form>
                <p>Já tem uma conta? <a href="./Login">Clique aqui</a> e faça login</p>
            </div>
            <div class="logo-wrapper">
                <img src="~/src/logo.png" alt="Logo ACESV">
            </div>
        </div>
    </body>
</div>
