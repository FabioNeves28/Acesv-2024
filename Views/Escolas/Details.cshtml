@model Acesv.Models.Escola

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Escola</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nome da Escola
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NomeEscola)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Voltar à lista</a>
</div>
