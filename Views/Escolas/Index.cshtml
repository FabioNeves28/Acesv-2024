@model IEnumerable<Acesv.Models.Escola>

@{
    ViewData["Title"] = "Escolas";
    bool isAuthenticated = User.Identity.IsAuthenticated;
}
<style>
    .w-100{
        width: 20% !important;
    }
</style>
<h1>Escolas</h1>

<p>
    <a asp-action="Create"><button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Criar nova escola</button></a></p>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var isAuthenticated = @Html.Raw(Json.Serialize(isAuthenticated));
        if (!isAuthenticated) {
            window.location.href = '/Identity/Account/AccessDeniedLogin';
        }
    });
</script>
<table class="table">
    <thead>
        <tr>
            <th>
                Nome da Escola
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeEscola)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
