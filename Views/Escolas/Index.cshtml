@model IEnumerable<Acesv.Models.Escola>

@{
    ViewData["Title"] = "Index";
    bool isAuthenticated = User.Identity.IsAuthenticated;
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var isAuthenticated = @Html.Raw(Json.Serialize(isAuthenticated));
        if (!isAuthenticated) {
            window.location.href = '/Identity/Account/AccessDeniedLogin';
        }
    });
</script>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeEscola)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeEscola)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
