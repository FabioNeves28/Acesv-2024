@model IEnumerable<Acesv.Models.Dados>

@{
    ViewData["Title"] = "Index";
}


<head>
    <link type="text/css" rel="stylesheet" href="~/css/escola.css" />
</head>
<div class="container">
    <h1>Transportadores Disponíveis</h1>

    <div class="search-container">
        <input type="text" id="searchInput" placeholder="Pesquisar">
        <span class="selected-school">Escola selecionada: <b>@ViewBag.EscolaSelecionada</b></span>
    </div>

    @if (ViewBag.Transportadores.Count > 0)
    {
        <table id="transportadoresTable">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Prefixo</th>
                    <th>Telefone</th>
                    <th>Bairros</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transportador in Model)
                {
                    <tr>
                        <td>@transportador.Apelido</td>
                        <td>@transportador.Prefixo</td>
                        <td>@transportador.Telefone</td>
                        <td>@transportador.Bairros</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination">
            <span>Resultados: @ViewBag.Resultados</span><br />
            <span>Página: @ViewBag.PaginaAtual de @ViewBag.TotalPaginas</span>
        </div>

        <div class="pagination-controls">
            @if (ViewBag.PaginaAtual > 1)
            {
                <a href="?nomeEscolaEscolhida=@ViewBag.EscolaSelecionada&pagina=@(ViewBag.PaginaAtual - 1)">Anterior</a>
            }
            else
            {
                <a class="disabled">Anterior</a>
            }

            @if (ViewBag.PaginaAtual < ViewBag.TotalPaginas)
            {
                <a href="?nomeEscolaEscolhida=@ViewBag.EscolaSelecionada&pagina=@(ViewBag.PaginaAtual + 1)">Próxima</a>
            }
            else
            {
                <a class="disabled">Próxima</a>
            }
        </div>
    }
    else
    {
        <p>Nenhum transportador encontrado para essa escola.</p>
    }
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function () {
        var input, filter, table, tr, td, i, j, txtValue;
        input = document.getElementById('searchInput');
        filter = input.value.toUpperCase();
        table = document.getElementById('transportadoresTable');
        tr = table.getElementsByTagName('tr');

        for (i = 1; i < tr.length; i++) {
            tr[i].style.display = "none";
            td = tr[i].getElementsByTagName('td');
            for (j = 0; j < td.length; j++) {
                if (td[j]) {
                    txtValue = td[j].textContent || td[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                        break;
                    }
                }
            }
        }
    });
</script>
