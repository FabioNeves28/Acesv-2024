            Total de Entradas
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Total_Entradas)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Contabilidade
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contabilidade)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Tarifa Bancária
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tarifa_Bancaria)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Apólice de Seguro
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Apolice_Seguro)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Advogada
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Advogada)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Renovação de Assinatura
