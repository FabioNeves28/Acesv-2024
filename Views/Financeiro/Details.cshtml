@model Acesvv.Models.Financeiro

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Financeiro</h4>
    <hr />
    <dl class="row" style="line-height: 28px;">
        <dt class="col-sm-2">
            Saldo do Mês
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Saldo_Mes)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Arrecadação de Mensalidades Atrasadas
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Arrecadacao_Mensalidade_Atrasada)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Arrecadação de Mensalidades Antecipadas
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Arrecadacao_Mensalidade_Antecipadas)
        </dd>
        <hr />
