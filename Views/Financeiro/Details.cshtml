            Taxas Bancárias
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Taxas_Bancarias)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Taxa de Internet
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Taxa_Internet)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Total de Gastos
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Total_Gastos)
        </dd>
        <hr />
        <dt class="col-sm-2">
            Total Líquido
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Total_Liquido)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Editar</a> |
    <a asp-action="Index">Voltar à lista</a>
</div>
